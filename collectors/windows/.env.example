# Copy to .env.windows at the project/package root. Never copy the server's .env to a VM.
# Loopback can reach the Mac backend through an SSH local port forward (see setup guide).
SIEM_API_URL=http://127.0.0.1:8000/api/v1/events
SIEM_API_KEY=replace-with-the-server-collector-key-only
COLLECTOR_LOOKBACK_SECONDS=300
COLLECTOR_POLL_SECONDS=5
# Default state: .local/collector under the project/package root. Do not copy it between hosts.
