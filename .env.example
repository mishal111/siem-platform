# Generate local keys with: python3 scripts/init_env.py
COLLECTOR_API_KEY=replace-with-a-random-secret-at-least-32-characters
ANALYST_API_KEY=replace-with-a-different-random-secret-at-least-32-characters
# Docker Compose uses its internal MongoDB address automatically.
# This loopback address is for an optional host Python installation.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=siem
CORS_ORIGINS=[]
MAX_REQUEST_BYTES=1048576
LOG_LEVEL=INFO
ALLOW_LEGACY_KEYS=true
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
SESSION_HOURS=8
LOGIN_USER_ATTEMPTS=10
LOGIN_PEER_ATTEMPTS=30
REQUESTS_PER_MINUTE=6000
MAX_CONCURRENT_REQUESTS=100
REQUEST_BODY_TIMEOUT_SECONDS=10

# Optional host collector overrides (all have defaults).
# SIEM_API_URL=http://127.0.0.1:8000/api/v1/events
# SIEM_API_KEY defaults to COLLECTOR_API_KEY above.
# COLLECTOR_POLL_SECONDS=5
# COLLECTOR_LOOKBACK_SECONDS=60
# COLLECTOR_BATCH_SIZE=20
# COLLECTOR_MAX_EVENTS=10000
# COLLECTOR_MAX_BYTES=16777216

# Optional detection worker overrides.
# DETECTION_POLL_SECONDS=1
# DETECTION_MAX_LATENESS_SECONDS=86400
# DETECTION_FUTURE_SKEW_SECONDS=120
